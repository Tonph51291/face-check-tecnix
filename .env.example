# ==============================================================================
# TECNIX KIOSK ANDROID - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép file này thành .env và điền các giá trị phù hợp với hệ thống của bạn:
# cp .env.example .env

# 1. Địa chỉ Backend Golang tecnix-office:
# - Chạy trên Android Emulator (máy ảo): http://10.0.2.2:8080/ (10.0.2.2 trỏ về localhost máy tính host)
# - Chạy trên Tablet / Điện thoại thật cùng mạng Wi-Fi: ví dụ http://192.168.1.100:8080/
# - Chạy trên Production (Cloud / Domain): ví dụ https://api.kiosk.tecnix.vn/
KIOSK_BASE_URL=http://10.0.2.2:8080/

# 2. Mã bí mật xác thực thiết bị Kiosk (gửi qua header X-Device-Key):
# Phải trùng khớp 100% với giá trị DEVICE_API_KEY trong file .env của backend
KIOSK_DEVICE_API_KEY=

# 3. Mã định danh của máy Kiosk chấm công này:
KIOSK_DEVICE_SERIAL=KIOSK-01
